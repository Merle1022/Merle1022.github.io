---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, withBase } from '../consts';

interface Series { title: string; slug: string }
interface Update { date: Date; summary: string }
interface FAQ { question: string; answer: string }
interface Props { title: string; description: string; image?: string; imageAlt?: string; date: Date; updatedDate?: Date; faqs?: FAQ[]; updates?: Update[]; author: string; tags: string[]; series?: Series; affiliateDisclosure?: boolean }
const { title, description, image, imageAlt, date, updatedDate, faqs = [], updates = [], author, tags, series, affiliateDisclosure = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const authorURL = new URL(withBase('about/'), Astro.site);
const articleImageURL = image ? new URL(withBase(image), Astro.site).href : undefined;
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: canonicalURL.href,
	datePublished: date.toISOString(),
	dateModified: (updatedDate ?? date).toISOString(),
	author: {
		'@type': 'Person',
		name: author,
		url: authorURL.href,
	},
	publisher: {
		'@type': 'Person',
		name: '梅爾 Merle',
		url: new URL('/', Astro.site).href,
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
	keywords: tags.join(', '),
	inLanguage: 'zh-Hant',
	...(articleImageURL ? { image: articleImageURL } : {}),
};
const faqSchema = faqs.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
} : null;
---
<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`${title}｜${SITE_TITLE}`} description={description} type="article" date={date} updatedDate={updatedDate} author={author} tags={tags} image={image} imageAlt={imageAlt} />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KXCJ92X8" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<main class="container article-shell">
			<article>
				<header class="article-header">
					<FormattedDate date={date} />
					{updatedDate && updatedDate.getTime() > date.getTime() && (
						<p class="article-updated">最後更新：<FormattedDate date={updatedDate} /></p>
					)}
					<h1>{title}</h1>
					<p>{description}</p>
					<p class="article-byline">作者：<a href={withBase('about/')}>{author}</a></p>
					{series && <a class="series-link" href={withBase(`blog/series/${series.slug}/`)}>專欄：{series.title}</a>}
					<div class="tags">{tags.map((tag) => <span>#{tag}</span>)}</div>
				</header>
				<aside class="tldr-box" aria-label="文章快速摘要">
					<strong>💡 快速摘要</strong>
					<p>{description}</p>
				</aside>
				{affiliateDisclosure && (
					<aside class="affiliate-disclosure" aria-label="聯盟行銷揭露">
						<strong>聯盟行銷揭露</strong>
						<p>本文可能包含聯盟連結。若你透過連結完成購買，我可能獲得少量分潤，但不影響你的價格與我的評價。</p>
					</aside>
				)}
				<slot name="toc" />
				<div class="prose"><slot /></div>
				{updates.length > 0 && (
					<section class="update-log" aria-labelledby="update-log-title">
						<h2 id="update-log-title">更新紀錄</h2>
						<ul>
							{updates.map((update) => <li><FormattedDate date={update.date} />：{update.summary}</li>)}
						</ul>
					</section>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tldr-box {
		margin: 1.5rem 0;
		padding: 1.25rem 1.5rem;
		border-left: 4px solid var(--accent, #0f766e);
		border-radius: 0.5rem;
		background: #f0fdfa;
	}

	.tldr-box p {
		margin: 0.5rem 0 0;
	}

	.article-updated { margin-top: .35rem; font-size: .84rem; }
	.article-byline a { text-underline-offset: .16em; }
	.update-log { width:min(100%,760px); margin:3rem auto 0; padding:1.25rem 1.5rem; border-top:2px solid var(--text); background:var(--surface); }
	.update-log h2 { margin:0 0 .65rem; font-size:1.1rem; }
	.update-log ul { margin:0; padding-left:1.2rem; }
	.update-log li { margin:.35rem 0; color:var(--muted); }
</style>
