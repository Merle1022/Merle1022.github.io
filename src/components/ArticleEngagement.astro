---
interface Props { title: string; url: string }
const { title, url } = Astro.props;
const articlePath = new URL(url).pathname;
const shareText = `${title}\n${url}`;
const links = [
  { name: 'LINE', href: `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`, path: 'M20 11.5C20 7.4 16.4 4 12 4S4 7.4 4 11.5c0 3.7 3 6.8 7 7.4V22c3.1-1.7 9-5.9 9-10.5Z' },
  { name: 'Threads', href: `https://www.threads.net/intent/post?text=${encodeURIComponent(shareText)}`, path: 'M18 8c-.5-3-2.5-5-6-5-5 0-8 3.5-8 9s3 9 8 9c4 0 7-2.5 7-6 0-3-2.5-5-6-5-3 0-5 1.5-5 3.5S9.5 17 12 17s4-2 4-5-1-5-4-5c-1.5 0-2.5.5-3 1.5' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, path: 'M14 22V13h3l.5-4H14V7c0-1 .5-2 2-2h2V1h-3c-3 0-5 2-5 5v3H7v4h3v9' },
];
---
<section id="article-feedback" class="article-engagement" data-article-path={articlePath} data-share-title={title} data-share-url={url} aria-labelledby="engagement-title">
  <h2 id="engagement-title">謝謝你讀到這裡</h2>
  <p class="engagement-intro">如果這篇對你有幫助，留個愛心，或分享給剛好需要的人。</p>
  <div class="engagement-actions">
    <div class="like-group">
      <button type="button" class="like-button" data-like-button aria-pressed="false" aria-label="這篇有幫助，送出愛心" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg>
        <span data-like-label>這篇有幫助</span>
        <span class="like-count" data-like-count aria-label="累計愛心數">—</span>
      </button>
      <span class="like-note">免費愛心・同一瀏覽器可取消</span>
    </div>
    <nav class="share-actions" aria-label="分享這篇文章">
      {links.map(({ name, href, path }) => <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`分享到 ${name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg><span>{name}</span></a>)}
      <button type="button" data-copy-link hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 13 4-4m-6 7-2 2a4.2 4.2 0 0 1-6-6l4-4a4.2 4.2 0 0 1 6 0m4 0 2-2a4.2 4.2 0 0 1 6 6l-4 4a4.2 4.2 0 0 1-6 0" transform="translate(1 0)" /></svg><span>複製連結</span></button>
      <button type="button" data-native-share hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v8h14v-8" /></svg><span>更多分享</span></button>
    </nav>
  </div>
  <div class="engagement-feedback">
    <p data-engagement-status role="status" aria-live="polite"></p>
    <button type="button" data-like-retry hidden>重新載入愛心</button>
  </div>
  <noscript><p class="like-note">開啟 JavaScript 後即可送出愛心；也可以使用上方的社群分享連結。</p></noscript>
  <div class="support-row">
    <div><p class="support-title">喜歡我的分享？</p><p>也歡迎請我喝杯咖啡，支持下一篇創作。</p></div>
    <a class="support-link" href="https://portaly.cc/merle1022/support" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">☕</span> 請我喝杯咖啡 <span aria-hidden="true">↗</span></a>
    <span class="support-note">自願小額贊助，將前往 Portaly 付款</span>
  </div>
  <dialog class="share-link-dialog" aria-labelledby="share-link-title">
    <h3 id="share-link-title">複製文章連結</h3>
    <p>長按或選取下方網址，即可複製分享。</p>
    <label for="share-link-value">文章網址</label><input id="share-link-value" type="text" value={url} readonly />
    <form method="dialog"><button>關閉</button></form>
  </dialog>
</section>
<script>
  const section = document.querySelector<HTMLElement>('[data-article-path]');
  if (section) {
    const button = section.querySelector<HTMLButtonElement>('[data-like-button]')!;
    const count = section.querySelector<HTMLElement>('[data-like-count]')!;
    const label = section.querySelector<HTMLElement>('[data-like-label]')!;
    const status = section.querySelector<HTMLElement>('[data-engagement-status]')!;
    const retry = section.querySelector<HTMLButtonElement>('[data-like-retry]')!;
    const endpoint = `/api/likes?article=${encodeURIComponent(section.dataset.articlePath!)}`;
    let busy = false;
    let loaded = false;
    const apply = (data: { count: number; liked: boolean }) => {
      if (!Number.isSafeInteger(data.count) || data.count < 0 || typeof data.liked !== 'boolean') throw new Error('invalid_response');
      count.textContent = data.count.toLocaleString('zh-TW');
      label.textContent = data.liked ? '謝謝你的愛心' : '這篇有幫助';
      button.setAttribute('aria-pressed', String(data.liked));
      button.setAttribute('aria-label', data.liked ? '已送出愛心，點擊取消' : '這篇有幫助，送出愛心');
      loaded = true; retry.hidden = true;
    };
    const request = async (liked?: boolean) => {
      const response = await fetch(endpoint, {
        method: liked === undefined ? 'GET' : 'PUT', credentials: 'same-origin',
        cache: 'no-store', signal: AbortSignal.timeout(12000),
        ...(liked === undefined ? {} : { headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ liked }) }),
      });
      if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        throw new Error(data.error || 'unavailable');
      }
      return response.json();
    };
    const load = async () => {
      if (busy) return;
      busy = true; button.disabled = true; retry.disabled = true;
      try { apply(await request()); status.textContent = ''; }
      catch { status.textContent = '愛心暫時無法載入，分享功能仍可使用。'; retry.hidden = false; }
      finally { busy = false; button.disabled = !loaded; retry.disabled = false; }
    };
    button.addEventListener('click', async () => {
      if (busy || !loaded) return;
      busy = true; button.disabled = true;
      const liked = button.getAttribute('aria-pressed') !== 'true';
      try {
        apply(await request(liked));
        status.textContent = liked ? '收到你的愛心，謝謝支持！' : '已取消愛心。';
      } catch (error) {
        const code = error instanceof Error ? error.message : '';
        status.textContent = code === 'rate_limited' ? '操作有點頻繁，請稍後再試。' : code === 'cookies_required' ? '瀏覽器需允許本站 Cookie 才能記住愛心，請重新載入後再試。' : '這次沒有送出成功，請稍後再試。';
      } finally { busy = false; button.disabled = false; }
    });
    retry.addEventListener('click', load);
    // Only load the counter near the article footer; ordinary page reads remain static.
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { observer.disconnect(); void load(); }
      }, { rootMargin: '400px' });
      observer.observe(section);
    } else { void load(); }
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && loaded) void load(); });
    const copy = section.querySelector<HTMLButtonElement>('[data-copy-link]')!;
    const native = section.querySelector<HTMLButtonElement>('[data-native-share]')!;
    const shareURL = section.dataset.shareUrl!;
    const shareTitle = section.dataset.shareTitle!;
    const manualCopy = () => {
      const dialog = section.querySelector<HTMLDialogElement>('.share-link-dialog')!;
      dialog.showModal();
      const input = dialog.querySelector<HTMLInputElement>('input')!;
      input.focus(); input.select();
    };
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(shareURL); status.textContent = '已複製文章連結。'; }
      catch { manualCopy(); }
    });
    if (typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', async () => {
        try { await navigator.share({ title: shareTitle, url: shareURL }); }
        catch (error) { if (!(error instanceof DOMException && error.name === 'AbortError')) manualCopy(); }
      });
    }
  }
</script>
<style>
  .article-engagement { width:min(100%,760px); margin:3.5rem auto 0; padding:2rem 0 0; scroll-margin-top:6rem; border-top:2px solid var(--text); }
  h2 { font-size:clamp(1.4rem,3vw,1.8rem); margin:0 0 .55rem; }
  .engagement-intro { margin:0 0 1.5rem; color:var(--muted); }
  .engagement-actions { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:1.5rem; }
  .like-group { display:flex; flex-direction:column; gap:.5rem; }
  button,a { -webkit-tap-highlight-color:transparent; }
  .like-button { display:inline-flex; align-items:center; justify-content:center; gap:.65rem; min-height:48px; padding:.7rem 1rem; border:1px solid #111; border-radius:999px; color:#111; background:#fff; font:inherit; font-size:.94rem; font-weight:700; cursor:pointer; }
  svg { width:21px; height:21px; flex:none; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .like-button svg { color:#b42349; }
  .like-button[aria-pressed='true'] { background:#fff0f3; border-color:#b42349; }
  .like-button[aria-pressed='true'] svg { fill:#b42349; }
  .like-button:disabled { opacity:.55; cursor:wait; }
  .like-count { min-width:1ch; font-variant-numeric:tabular-nums; }
  .like-note,.support-note { color:var(--muted); font-size:.76rem; }
  .share-actions { display:flex; flex-wrap:wrap; gap:.5rem; }
  .share-actions a,.share-actions button { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; min-height:44px; padding:.5rem .7rem; border:1px solid var(--line); border-radius:6px; background:transparent; color:var(--text); text-decoration:none; font:inherit; font-size:.8rem; cursor:pointer; }
  .share-actions a:hover,.share-actions button:hover { border-color:var(--text); background:#fff; }
  .share-actions svg { width:18px; height:18px; }
  [hidden] { display:none!important; }
  .engagement-feedback { min-height:2.5rem; display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; }
  .engagement-feedback p { margin:.5rem 0; color:var(--muted); font-size:.84rem; }
  [data-like-retry] { border:0; padding:.5rem; background:transparent; text-decoration:underline; color:var(--text); cursor:pointer; }
  .support-row { display:grid; grid-template-columns:1fr auto; gap:.5rem 1rem; align-items:center; margin-top:1.25rem; padding:1.5rem; border:1px solid var(--line); background:var(--surface); }
  .support-row p { margin:0; font-size:.9rem; color:var(--muted); }
  .support-row .support-title { margin-bottom:.25rem; font-size:1.05rem; font-weight:800; color:var(--text); }
  .support-link { display:inline-flex; align-items:center; justify-content:center; gap:.55rem; min-height:48px; padding:.65rem 1rem; border:1px solid var(--text); background:var(--accent); color:#111; text-decoration:none; font-size:.9rem; font-weight:800; }
  .support-link:hover { background:#fff; }
  .support-note { grid-column:1/-1; }
  button:focus-visible,a:focus-visible,input:focus-visible { outline:3px solid #7555b4; outline-offset:4px; }
  .share-link-dialog { width:min(90vw,540px); padding:1.5rem; border:1px solid #111; border-radius:8px; color:#111; background:#fff; }
  .share-link-dialog::backdrop { background:rgba(0,0,0,.6); }
  .share-link-dialog h3 { margin-top:0; }
  .share-link-dialog label { display:block; font-size:.8rem; }
  .share-link-dialog input { width:100%; padding:.75rem; margin:.4rem 0 1rem; border:1px solid #aaa; font:inherit; font-size:.85rem; }
  .share-link-dialog button { padding:.6rem 1rem; background:#111; color:white; border:0; font:inherit; cursor:pointer; }
  @media(max-width:520px) { .engagement-actions { flex-direction:column; gap:1.2rem; } .share-actions { width:100%; } .share-actions a,.share-actions button { flex:1 0 auto; } .support-row { grid-template-columns:1fr; padding:1.2rem; gap:.9rem; } .support-link { justify-self:start; } }
</style>
