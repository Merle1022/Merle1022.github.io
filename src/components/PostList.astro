---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { withBase } from '../consts';
import { readingTime, READING_TIME_NOTE } from '../utils/reading-time.mjs';
interface Props { posts: CollectionEntry<'posts'>[]; variant?: 'rows' | 'cards' }
const { posts, variant = 'rows' } = Astro.props;
const coverFor = (post: CollectionEntry<'posts'>) => {
 const source = post.data.image!; // Published content requires a cover in the schema.
 return { src: /^https?:\/\//.test(source) ? source : withBase(source), alt: post.data.imageAlt || post.data.title };
};
---
<ol class:list={['post-list', { 'post-card-grid': variant === 'cards' }]}>
	{posts.map((post) => (
		<li>
			{variant === 'cards' ? (
				<article class="post-card" data-post-card data-tags={post.data.tags.join('|')}>
					<a class="post-card-link" href={withBase(`blog/${post.id}/`)}>
						<div class="post-card-cover">
							<img src={coverFor(post).src} alt={coverFor(post).alt} width="640" height="400" loading="lazy" decoding="async" />
						</div>
						<div class="post-card-content">
							<p class="post-card-category">{post.data.tags[0] ?? '筆記'}</p>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						<p class="reading-time" title={READING_TIME_NOTE}>閱讀約 {readingTime(post.body)} 分鐘</p>
							<footer>
								<FormattedDate date={post.data.date} />
								<span>繼續閱讀 <b aria-hidden="true">→</b></span>
							</footer>
						</div>
					</a>
				</article>
			) : (
				<a class="post-row" href={withBase(`blog/${post.id}/`)}>
					<div>
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
						<p class="reading-time" title={READING_TIME_NOTE}>閱讀約 {readingTime(post.body)} 分鐘</p>
						<div class="tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>
					</div>
					<FormattedDate date={post.data.date} />
				</a>
			)}
		</li>
	))}
</ol>
