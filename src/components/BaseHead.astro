---
import '../styles/global.css';
import { SITE_TITLE, withBase } from '../consts';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	date?: Date;
	updatedDate?: Date;
	author?: string;
	tags?: string[];
}

const { title, description, type = 'website', date, updatedDate, author, tags = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.svg'), Astro.site);
---

<!-- Google Tag Manager -->
<script is:inline>
	(function (w, d, s, l, i) {
		w[l] = w[l] || [];
		w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
		var f = d.getElementsByTagName(s)[0];
		var j = d.createElement(s);
		var dl = l != 'dataLayer' ? '&l=' + l : '';
		j.async = true;
		j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
		f.parentNode.insertBefore(j, f);
	})(window, document, 'script', 'dataLayer', 'GTM-KXCJ92X8');
</script>
<!-- End Google Tag Manager -->

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="DTM2yNi2MzYF3eObymBrFP3M6xBG-aOuC65CrZUnkzk" />
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href={withBase('sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={withBase('rss.xml')} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />

<title>{title}</title>
<meta name="description" content={description} />
{author && <meta name="author" content={author} />}
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_TW" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`${SITE_TITLE} 網站分享圖片`} />
{date && <meta property="article:published_time" content={date.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{author && <meta property="article:author" content={author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
