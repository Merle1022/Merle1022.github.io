---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../consts';
import heroOne from '../assets/blog-placeholder-1.jpg';
import heroTwo from '../assets/blog-placeholder-4.jpg';
import heroThree from '../assets/blog-placeholder-about.jpg';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: '梅爾 Merle',
	alternateName: 'Merle',
	url: new URL('/', Astro.site).href,
	jobTitle: 'Content Creator & AI Collaborator',
	knowsAbout: [
		'Artificial Intelligence',
		'Prompt Engineering',
		'Astro Framework',
		'GitHub Pages',
		'Plant-based Lifestyle',
	],
	description: '整理生活體驗、AI 職場協作流程與數位工具開發，並推廣素食共桌生活專案。',
};
---
<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} isHome>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	<section class="hero home-hero" style={`--hero-one: url(${heroOne.src}); --hero-two: url(${heroTwo.src}); --hero-three: url(${heroThree.src});`}>
		<div class="hero-art" aria-hidden="true">
			<div class="hero-art-panel hero-art-panel-one"></div>
			<div class="hero-art-panel hero-art-panel-two"></div>
			<div class="hero-art-panel hero-art-panel-three"></div>
		</div>
		<div class="hero-content">
			<p class="eyebrow">MERLE · WRITING · AI · SLOW LIVING</p>
			<h1>把生活<br />整理成<br /><span>可延伸的內容</span></h1>
			<div class="hero-note">
				<p>記錄移動生活、AI 協作與素食日常，把親身走過的路，化成能被閱讀、使用與延伸的內容。</p>
				<a class="primary-action" href={withBase('blog/')}>開始閱讀 <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>
	<section class="latest-posts" aria-labelledby="latest-posts">
		<div class="section-heading">
			<p class="eyebrow">SELECTED NOTES</p>
			<h2 id="latest-posts">最新文章與正在發生的事</h2>
			<p>{posts.length} 篇筆記</p>
		</div>
		<PostList posts={posts} />
	</section>
</PageLayout>
